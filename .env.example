# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# Amazon Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Amazon OpenSearch
OPENSEARCH_ENDPOINT=your_opensearch_endpoint
OPENSEARCH_INDEX=content_chunks

# DynamoDB Tables
DYNAMODB_USERS_TABLE=eduquest-users
DYNAMODB_CONTENT_TABLE=eduquest-content
DYNAMODB_CHALLENGES_TABLE=eduquest-challenges
DYNAMODB_USER_CHALLENGES_TABLE=eduquest-user-challenges
DYNAMODB_ATTEMPTS_TABLE=eduquest-attempts
DYNAMODB_SQUADS_TABLE=eduquest-squads
DYNAMODB_SQUAD_MEMBERSHIPS_TABLE=eduquest-squad-memberships

# Amazon S3
S3_BUCKET=eduquest-content
S3_REGION=us-east-1

# Amazon SQS
SQS_QUEUE_URL=your_sqs_queue_url

# ElastiCache Redis
REDIS_HOST=your_redis_endpoint
REDIS_PORT=6379

# Amazon Cognito
COGNITO_USER_POOL_ID=your_user_pool_id
COGNITO_CLIENT_ID=your_client_id
COGNITO_REGION=us-east-1

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
API_RATE_LIMIT=100
